// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  PROOF_SUBMITTED
  PAID
  REJECTED
  REFUNDED
  EXPIRED
}

enum TransactionType {
  BOOKING_PAYMENT
  MEMBERSHIP_PURCHASE
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  USED_UP
  CANCELLED
}

enum NotificationType {
  BOOKING
  PAYMENT
  MEMBERSHIP
  SYSTEM
}

model User {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(125)
  email         String    @unique @db.VarChar(125)
  Passwordhash  String
  role          String    @db.VarChar(125)
  profile_Image String    @db.VarChar(125)
  createdAt     DateTime
  updatedAt     DateTime?

  bookings            Booking[]
  transactions        Transaction[]
  customerMemberships CustomerMembership[]
  reviews             Review[]
  notifications       Notification[]
}

model Court {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(125)
  description  String?
  sportType    String?  @db.VarChar(100)
  pricePerHour Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id                   String        @id @default(uuid())
  userId               String
  courtId              String
  customerMembershipId String?
  startTime            DateTime
  endTime              DateTime
  totalPrice           Decimal       @db.Decimal(12, 2)
  status               BookingStatus @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  court              Court               @relation(fields: [courtId], references: [id])
  customerMembership CustomerMembership? @relation(fields: [customerMembershipId], references: [id])
  transactions       Transaction[]
  review             Review?

  @@index([courtId, startTime, endTime])
  @@index([userId, status])
}

model Transaction {
  id                   String            @id @default(uuid())
  userId               String
  bookingId            String?
  customerMembershipId String?
  type                 TransactionType
  amount               Decimal           @db.Decimal(12, 2)
  status               TransactionStatus @default(PENDING)
  paymentMethod        String?           @db.VarChar(100)
  paymentProofUrl      String?
  expiresAt            DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  booking            Booking?            @relation(fields: [bookingId], references: [id])
  customerMembership CustomerMembership? @relation(fields: [customerMembershipId], references: [id])

  @@index([userId, status])
  @@index([bookingId])
}

model MembershipPlan {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(125)
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  sessionCount Int
  durationDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerMemberships CustomerMembership[]
}

model CustomerMembership {
  id                String           @id @default(uuid())
  userId            String
  membershipPlanId  String
  totalSessions     Int
  remainingSessions Int
  startsAt          DateTime?
  expiresAt         DateTime?
  status            MembershipStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id])
  bookings       Booking[]
  transactions   Transaction[]

  @@index([userId, status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  bookingId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
}
